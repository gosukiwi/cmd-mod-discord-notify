#!/usr/bin/env bash
#
# Uninstall the discord-notify mod for Command Code.
#
# Removes the installed mod file. Your config file is KEPT by default, because it holds
# your webhook URL — pass --purge to delete that too.
#
# Override the install location with COMMANDCODE_MODS_DIR if you keep mods elsewhere.

set -euo pipefail

MOD_NAME="discord-notify"
MODS_DIR="${COMMANDCODE_MODS_DIR:-$HOME/.commandcode/mods}"
TARGET="$MODS_DIR/$MOD_NAME.ts"
CONFIG="$HOME/.commandcode/discord-notify.json"

PURGE=false
case "${1:-}" in
	--purge) PURGE=true ;;
	-h | --help)
		echo "usage: $(basename "$0") [--purge]"
		echo
		echo "  (no args)  remove the installed mod, keep your config"
		echo "  --purge    also delete $CONFIG"
		exit 0
		;;
	"") ;;
	*)
		echo "error: unknown argument '$1' (try --help)" >&2
		exit 1
		;;
esac

if [[ -f "$TARGET" ]]; then
	rm -f "$TARGET"
	echo "removed mod    → $TARGET"
else
	echo "no mod at      → $TARGET (nothing to do)"
fi

if [[ "$PURGE" == true ]]; then
	if [[ -f "$CONFIG" ]]; then
		rm -f "$CONFIG"
		echo "removed config → $CONFIG"
	else
		echo "no config at   → $CONFIG (nothing to do)"
	fi
else
	echo "kept config    → $CONFIG (use --purge to remove it too)"
fi

# Only remove the mods directory if this mod left it empty; never touch anything else.
if [[ -d "$MODS_DIR" ]] && [[ -z "$(ls -A "$MODS_DIR")" ]]; then
	rmdir "$MODS_DIR"
	echo "removed empty  → $MODS_DIR"
fi
