#!/usr/bin/env bash
#
# Install the discord-notify mod for Command Code.
#
# Copies discord-notify.ts into the Command Code mods directory so it loads in every
# project, and drops a config template if you don't already have one.
#
# Override the destination with COMMANDCODE_MODS_DIR if you keep mods elsewhere.

set -euo pipefail

MOD_NAME="discord-notify"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$REPO_ROOT/$MOD_NAME.ts"

MODS_DIR="${COMMANDCODE_MODS_DIR:-$HOME/.commandcode/mods}"
TARGET="$MODS_DIR/$MOD_NAME.ts"
CONFIG_DIR="$HOME/.commandcode"
CONFIG="$CONFIG_DIR/discord-notify.json"

if [[ ! -f "$SOURCE" ]]; then
	echo "error: cannot find $SOURCE" >&2
	exit 1
fi

mkdir -p "$MODS_DIR"
cp "$SOURCE" "$TARGET"
echo "installed mod  → $TARGET"

if [[ -f "$CONFIG" ]]; then
	echo "kept config    → $CONFIG (left untouched)"
else
	mkdir -p "$CONFIG_DIR"
	cat > "$CONFIG" <<'JSON'
{
  "webhook": "",
  "mention": "",
  "quiet": false,
  "verbose": false
}
JSON
	echo "created config → $CONFIG"
fi

cat <<'NEXT'

Next steps:
  1. Discord → your channel → Integrations → Webhooks → New Webhook → Copy URL
  2. Put that URL in the config file's "webhook" field.
  3. Set "mention" to your Discord user id (Developer Mode on → right-click yourself
     → Copy User ID). This is what makes your phone actually buzz.
  4. In a Command Code session, run /notify-test.

Docs: see README.md
NEXT
